{
  "expo": {
    "name": "Cradlewell Bloom",
    "slug": "cradlewell-bloom",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF2FF"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-secure-store",
      "expo-notifications",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Cradlewell Bloom to use Face ID to unlock the app."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cradlewell.bloom",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.cradlewell.bloom",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EEF2FF"
      },
      "permissions": [
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "8bb9e471-c9e5-4d3f-b4b5-98fd3aaffca9"
      }
    },
    "owner": "lokesh-promise"
  }
}
