{
  "name": "cradlewell-bloom-server",
  "version": "1.0.0",
  "private": true,
  "description": "Authentication, client verification and monitoring-data API for Cradlewell Baby Tracker",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:setup": "node scripts/setup-db.js",
    "admin": "node scripts/admin.js",
    "test": "node --test --test-concurrency=1 test/",
    "build:admin": "node admin-src/build.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.3.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
