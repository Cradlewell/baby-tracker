# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000
# Set to 1 when running behind one reverse proxy (needed for correct per-IP rate limits).
# Use the number of proxies; "true" is refused (it would let anyone fake their IP address).
TRUST_PROXY=
# Only needed for the web build, e.g. http://localhost:8081
CORS_ORIGINS=

# --- Database 1: Authentication ---
AUTH_DB_HOST=127.0.0.1
AUTH_DB_PORT=3306
AUTH_DB_NAME=cradlewell_auth
AUTH_DB_USER=cw_auth_app
AUTH_DB_PASSWORD=change-me-auth-password

# --- Database 2: Clients and baby monitoring ---
CLIENTS_DB_HOST=127.0.0.1
CLIENTS_DB_PORT=3306
CLIENTS_DB_NAME=cradlewell_clients
CLIENTS_DB_USER=cw_clients_app
CLIENTS_DB_PASSWORD=change-me-clients-password

# MySQL admin account, used only by `npm run db:setup` to create the databases and users above.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
# Host the app users may connect from ('localhost' when the API runs next to MySQL).
DB_APP_USER_HOST=localhost

# --- Security ---
# Long random secret used to hash OTP codes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
OTP_SECRET=
SESSION_TTL_DAYS=30
OTP_RESEND_COOLDOWN_SECONDS=30
# Codes sent to one email or phone in 24 hours (access, password reset and sign-up together).
OTP_DAILY_LIMIT=4
# Nurses who sign up in the app wait for approval in the admin dashboard (false = log in at once).
NURSE_APPROVAL=true
# Days a nurse sign-up waits for approval before it is removed (the nurse is emailed and can sign up again).
NURSE_APPROVAL_DAYS=10
# Phone numbers typed without a country code get this prefix.
DEFAULT_COUNTRY_CODE=+91

# One-time codes for sign-up and client access.
# false = switched off: accounts are active at once, and a client opens after the
#         phone-number and authorization check.
# true  = codes are sent by SMS and must be entered (needs SMS_PROVIDER below).
OTP_ENABLED=false
# How a nurse proves a family agreed before their records open:
#   email = a code to the parent's email (their account email, or the one the nurse enters once)
#   sms   = a code to the family's phone (needs SMS_PROVIDER=twilio)
#   off   = opens at once (testing only; refused when NODE_ENV=production)
# Unset: "sms" when OTP_ENABLED=true, otherwise "off". "email" needs EMAIL_PROVIDER=smtp below.
CLIENT_CODE_CHANNEL=email
# A nurse enters a family's code once; it is never needed again for that family unless revoked
# (npm run admin -- revoke-access). Set a number of days to make it expire instead. 0 = never.
CLIENT_ACCESS_DAYS=0
# For this many days after a nurse entered a family's number, opening the app or logging in goes
# straight to that family's dashboard. After that the number is asked again (no code if verified before).
CLIENT_REMEMBER_DAYS=30

# --- Continue with Google ---
# The OAuth client IDs from Google Cloud Console (APIs & Services > Credentials), comma-separated:
# the Web client ID (the app asks Google for tokens for it) plus the Android and iOS client IDs.
GOOGLE_CLIENT_IDS=

# --- Email (password reset codes) ---
# console = print emails in this window (development only)
# smtp    = send real email (required when NODE_ENV=production), e.g. from care@cradlewell.com.
#           Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, an app password as SMTP_PASSWORD.
EMAIL_PROVIDER=console
EMAIL_FROM=Cradlewell Bloom <care@cradlewell.com>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# --- SMS ---
# console = print codes in this terminal (development only)
# twilio  = send real SMS (required when NODE_ENV=production)
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional instead of TWILIO_FROM_NUMBER
TWILIO_MESSAGING_SERVICE_SID=
